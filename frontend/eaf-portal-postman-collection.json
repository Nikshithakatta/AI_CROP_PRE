{
  "info": {
    "name": "EAF Portal - Seed Data",
    "description": "Postman collection for seeding EAF Portal with initial data",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@eafportal.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Login to get authentication token"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "pm.environment.set('authToken', jsonData.token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "AI Strategy Canvas",
      "item": [
        {
          "name": "Create AI North Star",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"visionStatement\": \"To become an AI-first organization that leverages cutting-edge AI technologies to drive innovation, efficiency, and competitive advantage across all business functions.\",\n  \"strategicObjectives\": [\n    \"Achieve 80% automation of repetitive tasks across all departments\",\n    \"Implement AI-driven decision support for 90% of strategic business decisions\",\n    \"Develop and deploy 15+ AI use cases with measurable ROI within 18 months\",\n    \"Establish Center of Excellence for AI with 30+ certified AI practitioners\"\n  ],\n  \"keyResults\": [\n    {\n      \"description\": \"Increase operational efficiency through AI automation\",\n      \"targetValue\": 80,\n      \"currentValue\": 35,\n      \"unit\": \"%\",\n      \"dueDate\": \"2026-12-31\"\n    },\n    {\n      \"description\": \"AI-driven revenue growth\",\n      \"targetValue\": 25,\n      \"currentValue\": 8,\n      \"unit\": \"% of total revenue\",\n      \"dueDate\": \"2026-12-31\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ai-strategy/north-star",
              "host": ["{{baseUrl}}"],
              "path": ["ai-strategy", "north-star"]
            },
            "description": "Create or update the AI North Star strategy"
          }
        },
        {
          "name": "Create Use Cases",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": JSON.stringify([
                {
                  "title": "Digital Transformation Strategy",
                  "description": "Comprehensive AI strategy for digital transformation in manufacturing",
                  "businessValue": 5,
                  "technicalFeasibility": 4,
                  "status": "in_progress"
                },
                {
                  "title": "Cloud Migration Plan",
                  "description": "AI-powered cloud migration strategy for financial services",
                  "businessValue": 4,
                  "technicalFeasibility": 3,
                  "status": "proposed"
                },
                {
                  "title": "AI Integration Roadmap",
                  "description": "End-to-end AI integration for healthcare provider",
                  "businessValue": 5,
                  "technicalFeasibility": 5,
                  "status": "completed"
                }
              ], null, 2)
            },
            "url": {
              "raw": "{{baseUrl}}/ai-strategy/use-cases/batch",
              "host": ["{{baseUrl}}"],
              "path": ["ai-strategy", "use-cases", "batch"]
            },
            "description": "Create multiple use cases in a batch"
          }
        }
      ]
    },
