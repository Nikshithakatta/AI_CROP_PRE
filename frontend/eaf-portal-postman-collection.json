    {
      "name": "Organization & Operating Model",
      "item": [
        {
          "name": "Set Organization Model",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": JSON.stringify({
                "coeModel": "hub_and_spoke",
                "raciMatrix": [
                  {
                    "activity": "AI Strategy Definition",
                    "responsible": "CDO Office",
                    "accountable": "CDO",
                    "consulted": ["Business Units", "Legal"],
                    "informed": ["All Employees"]
                  },
                  {
                    "activity": "Use Case Prioritization",
                    "responsible": "AI CoE",
                    "accountable": "Head of AI",
                    "consulted": ["Business Units", "Finance"],
                    "informed": ["IT"]
                  },
                  {
                    "activity": "Model Development",
                    "responsible": "Data Science Team",
                    "accountable": "Head of Data Science",
                    "consulted": ["Data Engineering", "Product"],
                    "informed": ["AI CoE"]
                  },
                  {
                    "activity": "Model Deployment",
                    "responsible": "ML Engineering",
                    "accountable": "Head of ML Engineering",
                    "consulted": ["Data Science", "Infrastructure"],
                    "informed": ["AI CoE", "Business Units"]
                  },
                  {
                    "activity": "Monitoring & Maintenance",
                    "responsible": "ML Ops",
                    "accountable": "Head of ML Ops",
                    "consulted": ["Data Science", "Security"],
                    "informed": ["AI CoE", "Business Units"]
                  }
                ],
                "kpis": [
                  {
                    "name": "Time to Market",
                    "description": "Average time from ideation to production deployment",
                    "targetValue": 60,
                    "unit": "days",
                    "frequency": "monthly"
                  },
                  {
                    "name": "Model Retraining Frequency",
                    "description": "How often models are retrained with new data",
                    "targetValue": 7,
                    "unit": "days",
                    "frequency": "monthly"
                  },
                  {
                    "name": "Model Drift",
                    "description": "Percentage of models experiencing performance degradation",
                    "targetValue": 5,
                    "unit": "%",
                    "frequency": "weekly"
                  },
                  {
                    "name": "AI Talent Growth",
                    "description": "Number of employees trained in AI/ML",
                    "targetValue": 100,
                    "unit": "employees",
                    "frequency": "quarterly"
                  }
                ]
              }, null, 2)
            },
            "url": {
              "raw": "{{baseUrl}}/organization/model",
              "host": ["{{baseUrl}}"],
              "path": ["organization", "model"]
