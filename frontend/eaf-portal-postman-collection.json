    {
      "name": "Data & Platform Strategy",
      "item": [
        {
          "name": "Set Data Platform Architecture",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": JSON.stringify({
                "model": "data_lakehouse",
                "components": [
                  {
                    "name": "Data Ingestion",
                    "type": "ingestion",
                    "technology": "Apache Kafka, AWS Kinesis",
                    "description": "Real-time and batch data ingestion layer",
                    "status": "live"
                  },
                  {
                    "name": "Data Storage",
                    "type": "storage",
                    "technology": "Delta Lake, Amazon S3",
                    "description": "Unified storage layer for raw and processed data",
                    "status": "live"
                  },
                  {
                    "name": "Data Processing",
                    "type": "processing",
                    "technology": "Apache Spark, Databricks",
                    "description": "Distributed data processing framework",
                    "status": "live"
                  },
                  {
                    "name": "Model Serving",
                    "type": "serving",
                    "technology": "Seldon Core, TorchServe",
                    "description": "Model deployment and serving infrastructure",
                    "status": "in_progress"
                  },
                  {
                    "name": "Monitoring",
                    "type": "monitoring",
                    "technology": "Prometheus, Grafana",
                    "description": "Infrastructure and model monitoring",
                    "status": "in_progress"
                  },
                  {
                    "name": "Governance",
                    "type": "governance",
                    "technology": "Collibra, Alation",
                    "description": "Data catalog and governance tools",
                    "status": "planned"
                  }
                ],
                "modelRegistry": {
                  "url": "https://mlflow.eafportal.com",
                  "type": "mlflow"
                },
                "vectorDB": {
                  "type": "weaviate",
                  "configuration": {
                    "url": "https://weaviate.eafportal.com",
                    "embeddingModel": "text-embedding-3-large",
                    "replicationFactor": 3
                  }
                },
                "buildVsBuyAnalysis": {
                  "decision": "hybrid",
                  "rationale": "Leverage best-of-breed managed services while building custom components for differentiation",
                  "costComparison": {
                    "buildCost3Yr": 2500000,
                    "buyCost3Yr": 1800000,
                    "hybridCost3Yr": 2000000,
                    "buildTco": 3.2,
                    "buyTco": 2.8,
                    "hybridTco": 2.9
                  }
                }
              }, null, 2)
            },
            "url": {
              "raw": "{{baseUrl}}/data-platform/architecture",
              "host": ["{{baseUrl}}"],
              "path": ["data-platform", "architecture"]
            },
            "description": "Set the data platform architecture"
          }
        }
      ]
    },
